{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/code/vscode-extension"
      ],
      "outFiles": ["${workspaceFolder}/code/vscode-extension/dist/**/*.cjs"],
      "preLaunchTask": "npm: watch-all"
    },
    {
      "name": "Debug Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/code/vscode-extension"
      ],
      "outFiles": ["${workspaceFolder}/code/vscode-extension/dist/**/*.cjs"],
      "preLaunchTask": "npm: watch-all",
      "env": {
        "DEBUG_FANGTYPE": "1",
        "DEBUG_FANGTYPE_WAIT": "1"
      }
    },
    {
      "name": "Python: Attach to Fangtype Server",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug Extension + Python",
      "configurations": ["Debug Extension", "Python: Attach to Fangtype Server"]
    }
  ]
}
