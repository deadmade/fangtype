{
    "name": "auto-type",
    "displayName": "Auto Type",
    "description": "Interactive Python type annotation with ghost text",
    "version": "0.3.0",
    "publisher": "auto-type",
    "author": "deadmade",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/deadmade/fangtype.git"
    },
    "engines": {
        "vscode": "^1.108.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:python",
        "workspaceContains:**/*.py",
        "workspaceContains:**/pyproject.toml",
        "workspaceContains:**/requirements.txt"
    ],
    "main": "./dist/extension.cjs",
    "contributes": {
        "commands": [
            {
                "command": "autoType.insertTypeAtCursor",
                "title": "Auto Type: Insert Type Annotation at Cursor",
                "category": "Auto Type"
            },
            {
                "command": "autoType.insertAllTypes",
                "title": "Auto Type: Insert All Type Annotations in File",
                "category": "Auto Type"
            },
            {
                "command": "autoType.removeTypeAtCursor",
                "title": "Auto Type: Remove Type Annotation at Cursor",
                "category": "Auto Type"
            },
            {
                "command": "autoType.removeAllTypes",
                "title": "Auto Type: Remove All Type Annotations in File",
                "category": "Auto Type"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "autoType.insertTypeAtCursor",
                    "when": "editorTextFocus && editorLangId == python",
                    "group": "9_autoType@1"
                },
                {
                    "command": "autoType.insertAllTypes",
                    "when": "editorTextFocus && editorLangId == python",
                    "group": "9_autoType@2"
                },
                {
                    "command": "autoType.removeTypeAtCursor",
                    "when": "editorTextFocus && editorLangId == python",
                    "group": "9_autoType@3"
                },
                {
                    "command": "autoType.removeAllTypes",
                    "when": "editorTextFocus && editorLangId == python",
                    "group": "9_autoType@4"
                }
            ],
            "commandPalette": [
                {
                    "command": "autoType.insertTypeAtCursor",
                    "when": "editorLangId == python"
                },
                {
                    "command": "autoType.insertAllTypes",
                    "when": "editorLangId == python"
                },
                {
                    "command": "autoType.removeTypeAtCursor",
                    "when": "editorLangId == python"
                },
                {
                    "command": "autoType.removeAllTypes",
                    "when": "editorLangId == python"
                }
            ]
        },
        "keybindings": [
            {
                "command": "autoType.insertTypeAtCursor",
                "key": "alt+enter",
                "when": "editorTextFocus && editorLangId == python"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Auto Type",
            "properties": {
                "autoType.inlayHintsEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to show inlay hints in the editor."
                },
                "autoType.showUsageHints": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to show usage-site hints (e.g. for variables used in expressions)."
                },
                "autoType.preferModernTypes": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to prefer modern Python 3.10+ types (e.g., list[int] instead of List[int])."
                },
                "autoType.mypyEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to run mypy validation for diagnostics."
                },
                "autoType.mypyInferenceValidationEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to run mypy validation for inference-result validation (e.g., inlay hints)."
                },
                "autoType.diagnosticSeverity": {
                    "type": "string",
                    "default": "information",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint"
                    ],
                    "description": "Minimum severity for diagnostics."
                },
                "autoType.skipAnnotated": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to skip variables that already have a type annotation when inserting all types."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build && npm run bundle-server",
        "build": "npx tsx ./scripts/build-with-esbuild.ts",
        "watch": "npx tsx ./scripts/watch-with-esbuild.ts",
        "bundle-server": "npx tsx ./scripts/bundle-server.ts",
        "package": "vsce package",
        "lint": "eslint src",
        "pretest": "npm run bundle-server && npm run package",
        "test": "steam-run vscode-test",
        "test:ci": "vscode-test"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/node": "^25.2.0",
        "@types/vscode": "^1.108.1",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "2.5.2",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.27.2",
        "eslint": "^10.0.0",
        "glob": "^13.0.0",
        "mocha-junit-reporter": "^2.2.1",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.56.0"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "icon": "image.png"
}
