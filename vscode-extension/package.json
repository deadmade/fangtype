{
  "name": "auto-type",
  "displayName": "Auto Type",
  "description": "Interactive Python type annotation with ghost text",
  "version": "0.2.0",
  "publisher": "auto-type",
  "author": "deadmade",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deadmade/fangtype.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autoType.insertTypeAtCursor",
        "title": "Auto Type: Insert Type Annotation at Cursor",
        "category": "Auto Type"
      },
      {
        "command": "autoType.insertAllTypes",
        "title": "Auto Type: Insert All Type Annotations in File",
        "category": "Auto Type"
      },
      {
        "command": "autoType.removeTypeAtCursor",
        "title": "Auto Type: Remove Type Annotation at Cursor",
        "category": "Auto Type"
      },
      {
        "command": "autoType.removeAllTypes",
        "title": "Auto Type: Remove All Type Annotations in File",
        "category": "Auto Type"
      }
    ],
    "keybindings": [
      {
        "command": "autoType.insertTypeAtCursor",
        "key": "alt+enter",
        "when": "editorTextFocus && editorLangId == python"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle-server",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle-server": "python scripts/bundle_server.py",
    "package": "vsce package"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.5",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "icon": "image.png"
}
