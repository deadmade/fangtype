# Development files
.vscode/**
.vscode-test/**
src/**
*.ts
!*.d.ts
tsconfig.json
.gitignore
.eslintrc*
*.map
esbuild.js

# Git
.git/**

# Build scripts and config
scripts/**
noxfile.py
requirements.txt

# Documentation (keep README)
*.md
!README.md

# Test files
**/*.test.ts
**/__tests__/**

# Node modules - Exclude entirely because we bundle with esbuild
node_modules/**

# Python cache files in bundled directory
bundled/**/__pycache__/**
bundled/**/*.pyc
bundled/**/*.pyo
bundled/**/py.typed
