# VSCode/Editor Configuration
.vscode/**
.vscode-test/**

# Source Files (TypeScript - we bundle with esbuild)
src/**
test/**
*.ts
!*.d.ts

# Build Configuration
tsconfig.json
tsconfig.test.json
esbuild.js
eslint.config.mjs

# Test Files
**/*.test.ts
**/__tests__/**
test-output.log
.vscode-test.mjs*
workspace/**
test-results.xml

# Build Output
out/**
*.map

# Retired PyInstaller server binary (server now runs from bundled/ sources)
dist/fangtype-server

# Python bytecode caches: bundled/libs + bundled/tool sources must ship, caches
# must not. Repo-wide so stray caches (e.g. __pycache__/noxfile.pyc created when
# nox imports the noxfile) never leak into the VSIX.
**/__pycache__/**
**/*.pyc

# Dependencies (bundled with esbuild)
node_modules/**

# Version Control
.git/**
.gitignore

# Documentation (keep README)
*.md
!README.md

# Python-related (keep for dual-project)
.mypy_cache
noxfile.py
requirements.txt
# ...but the copy shipped alongside the bootstrap (for env installs) must ship.
!bundled/requirements.txt

# Misc
.prettierignore
scripts/**

.ruff_cache/
.pytest_cache/
htmlcov/
tests/

# python dependencies metadata and tests
bundled/libs/**/*.dist-info
bundled/libs/**/tests
bundled/libs/**/test
bundled/libs/**/docs
bundled/libs/**/examples

# Defensive guard: stray/stale vendored dirs from an old model (e.g. a
# root-owned bundled/libs_old_root/ with native cp312 .so files) must never
# leak into a `vsce package` run from a dirty dev tree.
bundled/libs_old*/**
